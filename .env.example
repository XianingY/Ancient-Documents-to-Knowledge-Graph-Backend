# 文渊智图 · 后端环境变量配置
#
# 使用方法：
#   1. 复制本文件为 .env（与 main.py 同级目录）
#   2. 填写必填项，按需修改可选项
#   3. 启动服务前确保 .env 文件已就绪
#
# 注意：请勿将包含真实密钥的 .env 文件提交到版本库

# ============ 必填 ============

# JWT 签名密钥（请替换为足够长的随机字符串）
SECRET_KEY=请替换为足够长的随机字符串

# ============ 可选 ============

# 阿里云 DashScope API 密钥（结构化、问答、OCR 兜底所需；本地 PaddleOCR 不需要）
# DASHSCOPE_API_KEY=

# ============ 离线实验（可选） ============

# 仅 experiments/llm_extraction.py 使用，线上服务不读取
# DEEPSEEK_API_KEY=

# Redis 配置（Celery 任务队列依赖）
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=0

# 服务端口
# SERVER_PORT=3000

# 图片存储目录
# UPLOAD_DIR=pic

# 数据库连接（默认使用 SQLite: database/app.db）
# DATABASE_URL=

# ============ OCR ============

# 本地 PaddleOCR 主管线；Paddle 不可用时可回退到 Qwen conservative。
# OCR_ENGINE=paddle_v6_consensus
# OCR_FALLBACK_ENGINE=qwen_conservative

# 图像预处理与识别参数
# OCR_TARGET_LONG_SIDE=2400
# OCR_DETECTION_THRESHOLD=0.2
# OCR_BOX_THRESHOLD=0.3
# OCR_UNCLIP_RATIO=1.2
# OCR_RECOGNITION_BATCH_SIZE=16

# 双模型共识与保守屏蔽
# OCR_CONSENSUS_MIN_SCORE=0.45
# OCR_CONSENSUS_MIN_SIMILARITY=0.40

# 字符级救援
# OCR_CHAR_RESCUE_ENABLED=true
# OCR_CHAR_RESCUE_USE_TINY=true
# OCR_CHAR_RESCUE_MIN_SCORE=0.45
# OCR_CHAR_RESCUE_MIN_LINE_CONFIDENCE=0.70
# OCR_CHAR_RESCUE_MAX_LINE_CHARS=48

# 布局多视图（默认关闭以保持稳定单视图输出）
# OCR_MULTIVIEW_ENABLED=false
# OCR_LAYOUT_ORIENTATION=vertical
# OCR_LAYOUT_CLUSTER_IOU=0.45
# OCR_LAYOUT_SINGLE_VIEW_MAX_CHARS=6
# OCR_LAYOUT_SINGLE_VIEW_MIN_CONFIDENCE=0.75
